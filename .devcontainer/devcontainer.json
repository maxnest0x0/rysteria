{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "postCreateCommand": {
        "Client": "cmake -S Client -B Client/build -DWASM_BUILD=1",
        "Default Server": "cmake -S Server -B Server/build-default",
        "PvP Server": "cmake -S Server -B Server/build-pvp -DPVP=1",
        "Master Server": "npm install --prefix MasterServer"
    },
    "portsAttributes": {
        "8080": {
            "label": "HTTP Server",
            "onAutoForward": "openBrowser"
        },
        "55554": {
            "label": "Master Server",
            "onAutoForward": "silent"
        },
        "1234": {
            "label": "Default Server",
            "onAutoForward": "openBrowserOnce"
        },
        "1235": {
            "label": "PvP Server",
            "onAutoForward": "openBrowserOnce"
        }
    },
    "remoteUser": "root"
}
